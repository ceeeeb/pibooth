[Unit]
Description=Pibooth captive portal redirector
After=network.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /home/pi/captive-portal.py
# Binds port 80 without running as root; retries until wlan1 owns 10.42.0.1.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
